java/build/
java/sdk/build/
java/.gradle/
java/starter/template/.gradle/
java/starter/template/build/

# C# / .NET
bin/
obj/
*.nupkg

# Generated protobuf code (scripts/buf-generate.sh). Only go/api/ is committed.
.buf-generate.stamp
node/sdk/src/common/gen/
python/sdk/src/t0_provider_sdk/api/**/*.py
python/sdk/src/t0_provider_sdk/api/**/*.pyi
!python/sdk/src/t0_provider_sdk/api/buf/__init__.py
!python/sdk/src/t0_provider_sdk/api/buf/validate/__init__.py
csharp/sdk/T0.ProviderSdk/Api/

# Go helper binary (built for cross-tests)
cross_test/go_helper/go_helper

